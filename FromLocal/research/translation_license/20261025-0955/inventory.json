    {
      "poem": "P08b_Zhuangzi_Xiaoyao",
      "player_language": "ja",
      "actual_language": "ja",
      "object": 2,
      "text": "其の下を視るや亦た / 是くの若くならんのみ",
      "source": "庄子《逍遥游》",
      "original_language": "zh",

    },
    {
      "poem": "P08b_Zhuangzi_Xiaoyao",
      "player_language": "ja",
      "actual_language": "ja",
      "object": 0,
      "text": "天の蒼蒼たるは / 其れ正色なるか",
      "source": "庄子《逍遥游》",

     // which Lanbai/Cabin variant an FBX object gets. Window_* / Pole_* are the D-40 #1 slice pieces that finish_bus.py
     // now exports on their own (Window_R1, Pole_R0): they were part of Cabin_Static and stay on its tube light map.
+    // The imported FBX has the opposite X/Z basis from BusLayout.json on this Unity import.
+    // Correct only the proven 180-degree case, then bake the correction into child transforms
+    // so the model stays identity and doorClosedPos (layout/world coordinates) remains valid.
+    internal static string AlignModelToLayout(Transform model, Layout layout)
+    {
+        var hero = layout.seats.First(x => x.hero);
+        var seat = FindDeep(model, "Seat_" + hero.name);
+        if (seat == null || seat.GetComponent<Renderer>() == null) throw new Exception("Hero mesh missing for layout-axis verification");
+        Vector3 p = model.InverseTransformPoint(seat.GetComponent<Renderer>().bounds.center);
+        Vector2 expected = new Vector2(hero.x, hero.back_z + 0.25f);
+        float direct = Vector2.Distance(new Vector2(p.x, p.z), expected);
+        float reversed = Vector2.Distance(new Vector2(-p.x, -p.z), expected);
+        if (direct < 0.5f) return "FBX/model axes agree with BusLayout hero seat";
+        if (reversed > 0.5f || direct < 1f) throw new Exception("Unknown FBX/layout mismatch; refusing automatic correction");
+        var children = model.Cast<Transform>().ToArray();
+        model.localRotation = Quaternion.Euler(0f, 180f, 0f);
+        foreach (var child in children) child.SetParent(model.parent, true);
+        model.localRotation = Quaternion.identity;
+        foreach (var child in children) child.SetParent(model, true);
+        Vector3 after = model.InverseTransformPoint(seat.GetComponent<Renderer>().bounds.center);
+        if (Vector2.Distance(new Vector2(after.x, after.z), expected) > 0.5f) throw new Exception("FBX axis correction verification failed");
+        return "Corrected imported FBX X/Z reversal against BusLayout; model identity, mesh/station/collider frame aligned";
+    }
+

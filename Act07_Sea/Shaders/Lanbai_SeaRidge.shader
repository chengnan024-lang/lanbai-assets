// =====================================================================================================
//  Lanbai/SeaRidge   蓝白 · 第 7a 幕 F3e2 的海脊石壁（圣经 §6·7a：右窗外一道海脊的石壁升过去，距离 ≥ 12 m，低对比，
//                    只被船体生物荧光 #8AC6FF 描出一道边——第一次有了量深度的尺子）
//
//  !!! WRITTEN WITHOUT A UNITY COMPILER (cloud side). Checked with DXC + Unity 2022.3 CGIncludes (Common/Tools~/compile_check), never in Unity. !!!
//
//  Mesh: generated by 蓝白/Build/Act07a from Act07_Layout.json 'ridge' (a heightfield in the WATER frame, under R_Sea).
//  Look: a dark base just above the water fog of that depth (low contrast) + a rim: the hull's light reaching the rock,
//  E ~ facing x exp(-distance / _RimReach) (the trails are a moving glow along the hull; the bus is the source), shaped
//  toward grazing (the edges catch it: '描出一道边'). Then LanbaiFog. Opaque, Geometry. _Gain (driver) = the trails on.
// =====================================================================================================
Shader "Lanbai/SeaRidge"
{
    Properties
    {
        _Base ("Base colour linear", Vector) = (0.004, 0.009, 0.014, 0)
        _Rim ("Rim colour linear  the bioluminescence", Vector) = (0.04, 0.06, 0.40, 0)
        _RimReach ("Rim reach m", Float) = 16
        _RimEdge ("Rim edge power", Range(0.5, 4)) = 2
        _BusPos ("Bus light centre  world", Vector) = (0, 1.2, 0, 0)
        _Gain ("Gain  driver", Float) = 1
    }
    SubShader
    {
        Tags { "RenderType" = "Opaque" "Queue" = "Geometry" "IgnoreProjector" = "True" }
        Pass
        {
            Tags { "LightMode" = "ForwardBase" }
            Cull Back
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #pragma target 3.5
            #pragma multi_compile_fog
            #pragma multi_compile_instancing
            #include "UnityCG.cginc"
            #include "Assets/Lanbai/Common/Shaders/LanbaiVR.cginc"
            #include "Assets/Lanbai/Common/Shaders/LanbaiGlobals.cginc"
            #include "Assets/Lanbai/Common/Shaders/LanbaiFog.cginc"

            float4 _Base, _Rim, _BusPos;
            float _RimReach, _RimEdge, _Gain;

            struct appdata
            {
                float4 vertex : POSITION;
                float3 normal : NORMAL;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };
            struct v2f
            {
                float4 pos : SV_POSITION;
                float3 posWS : TEXCOORD0;
                float3 nWS : TEXCOORD1;
                UNITY_VERTEX_OUTPUT_STEREO
            };

            v2f vert(appdata v)
            {
                v2f o;
                UNITY_SETUP_INSTANCE_ID(v);
                UNITY_INITIALIZE_OUTPUT(v2f, o);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(o);
                o.posWS = mul(unity_ObjectToWorld, v.vertex).xyz;
                o.nWS = UnityObjectToWorldNormal(v.normal);
                o.pos = UnityWorldToClipPos(o.posWS);
                return o;
            }

            float4 frag(v2f i) : SV_Target
            {
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(i);
                float3 N = normalize(i.nWS);
                float3 eye = LanbaiCentreEyePos();
                float3 V = normalize(eye - i.posWS);
                float3 toBus = _BusPos.xyz - i.posWS;
                float d = length(toBus);
                float facing = saturate(dot(N, toBus / max(d, 1e-3)));
                float edge = pow(1.0 - saturate(dot(N, V)), _RimEdge);
                float rim = facing * exp(-d / max(_RimReach, 0.1)) * (0.25 + 0.75 * edge) * _Gain;
                float3 col = _Base.rgb + _Rim.rgb * rim;
                col = LanbaiApplyFog(col, i.posWS);
                return float4(col, 1.0);
            }
            ENDCG
        }
    }
    FallBack Off
}

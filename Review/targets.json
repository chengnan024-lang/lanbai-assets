{
 "_about": "Lanbai art-review targets, generated by Review/Tools~/build_targets.py from Art/ART_BIBLE.md v2.1 (+ Gate README §12 v2.3 for act 4). Screen targets are law (bible law 1). APL = mean Rec.709 luma of the sRGB 8-bit screenshot (0–255).",
 "camera": {
  "res": [
   1920,
   1080
  ],
  "hfov_deg": 90,
  "eye": "hero seat (Gate/GateLayout_v2.json cameras.U7 ≈ (0.55,1.70,2.05)); README must state which",
  "grade": "PPv2 HDR + Neutral, the act profile at weight 1, bloom on (APL includes bloom)"
 },
 "global": {
  "violet_rule": {
   "src": "§1.3.4",
   "global": "outside acts 4/4c: no region > 2% of frame with h_ab 290–325 AND C* > 15 (CIE Lab, D65)",
   "act4": "U7–U8 straight-ahead: C* > 30 violet (h 290–325) ≤ 10%; violet only near the wound",
   "act6": "stricter: no region > 2% with h_ab 285–330 AND C* > 12 (no lavender in dawn)",
   "global_except_cowrie": "as global; the cowrie gate #7A4A6E is the only allowed violet echo, small, only beside its lamp",
   "measure": "both whole-frame pixel fraction and largest 8-connected component (2% = 41 472 px at 1920x1080)"
  },
  "black_white_rule": {
   "src": "§1.3.5",
   "rule": "no region > 2% of frame below #030409 or above #F4F7FA; night floor #04060B; only act 5 may reach #030409; small emitters may clip",
   "luma_floor_night": "night lift lands input 0 at ≈ #02060C; never red = 0"
  },
  "one_brightest": {
   "src": "§1.3.1",
   "rule": "one brightest point per frame and it is where the eye should go; measure: the brightest 2000 px (and L*>85 px) sit in ONE connected cluster on the act's named focus"
  },
  "shadows_blue": {
   "src": "§1.3.2",
   "rule": "no warm hue in shadows (L* < 25 px: h_ab outside 20–100 or C* < 6) — even in warm scenes"
  },
  "warm_rationed": {
   "src": "§1.3.3",
   "rule": "warm only: sodium, headlights, tail lights, radio dial, warm-white point in 4c, two suns, palace lamps, Lichtchen; distant warm always small"
  },
  "horizon_level": {
   "src": "§1.3.6",
   "rule": "horizon perfectly level: fitted horizon line slope ≤ 0.1° (≈ 1.7 px over 1920 at 90° hFOV); bus never pitches/rolls"
  },
  "nothing_touches": {
   "src": "§1.3.8",
   "rule": "tentacles, mirror rims, waves never touch the bus; only light bands cross it. ≥ 8 m for tentacles, nothing within 0.3 m of the eye"
  },
  "top25_Lstar": {
   "src": "Gate acceptance (README §10) / local metrics",
   "rule": "upper 25% of frame L* p90 — night acts ≤ 5–10 except where the act's light is up there (wound, sun, skylight)"
  },
  "palette_dE": {
   "src": "§1.5 law 1 (screen targets are law)",
   "rule": "for every palette swatch: nearest pixel cluster ΔE2000 ≤ 5 = on target, 5–10 = drift (minor), > 10 or swatch absent where the act needs it = blocking if it is a named role (sky, shadow, focus)"
  },
  "APL_tol": {
   "src": "§1.5 step 4",
   "rule": "APL within ±15% of §2.2 at the segment midpoint t; desktop 1920x1080 hFOV 90, straight ahead, incl. bloom"
  },
  "VR_peak": {
   "src": "§1.8",
   "rule": "VR full-frame APL ≤ 150 except the white; white desktop #E8F1F5 (239) / VR #D7E3E8 (224); held ≤ 30 s"
  },
  "ramp_law": {
   "src": "§1.8",
   "rule": "any brightening: ≤ 0.5 EV / 0.25 s, ≤ 1.0 EV / 1 s, ≤ 1.8 EV / 2 s (L floor 0.004); ≤ 2 flashes / any 1 s in any 4.4° tile; red flash rule; run Art/tools/lens_tech/flashcheck.py <dir> --fps 60 --hfov 90"
  },
  "poem_luma": {
   "src": "§1.6 / §7.2",
   "rule": "poem text screen ≤ luma 224, no glow, no outline, no shadow"
  },
  "albedo": {
   "src": "§1.6",
   "rule": "non-metal sRGB 48–231 (exceptions: black rubber/paint/linen ≥ 38; tentacles 30–44; wet asphalt/mud Lagarde); nothing > 235; bus white ≤ 218; metal albedo ≥ 150; metallic 0 or 1"
  },
  "text_share": {
   "src": "§7.4",
   "rule": "text on screen ≤ 40% of the act; no text in the first 8 s of any act, dawn F0–F1, first 8 s after leaving the sea, dusk transform, F13–F16, the white"
  },
  "motion": {
   "src": "§1.8",
   "rule": "objects passing within 20 m: ≤ 60°/s at the eye (v ≤ 1.05 d); colossi self-motion ≤ 0.5°/s; roll = pitch = 0; yaw only acts 2/11 ≤ 3°/s"
  }
 },
